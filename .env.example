# ---- LLM (任何 OpenAI 兼容接口：DeepSeek / Moonshot / Qwen / GPT ...) ----
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600
LLM_TIMEOUT=180

# ---- Embedding ----
# openai = 走 LLM_BASE_URL 的 /embeddings（推荐，需服务端支持）
# hash   = 本地确定性哈希向量，零依赖离线可用（检索退化为词面匹配，仅用于自测/断网演示）
# chroma = 使用 ChromaDB 内置 ONNX 模型（all-MiniLM-L6-v2，首次运行会下载）
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
# 单次请求的最大条数（Qwen 上限 25，默认 16 留余量）
EMBEDDING_BATCH_SIZE=16

# ---- 向量库 ----
# chroma = 本地持久化 ChromaDB（默认）；local = 纯 numpy 索引（无 chromadb 依赖时的兜底）
STORE_BACKEND=chroma
# INDEX_DIR 默认 <项目根>/var/index

# ---- 语料与分块 ----
# DATA_DIR 默认 <项目根>/data；UPLOAD_DIR 默认 <项目根>/var/uploads（前端上传的 PDF 落盘位置）
# LEARNING_DIR 默认 <项目根>/var/learning（课程地图 outline.json 与学习进度 progress.json）
# DATA_DIR=./data
# UPLOAD_DIR=./var/uploads
# LEARNING_DIR=./var/learning
MAX_UPLOAD_MB=30
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=40

# ---- 检索 ----
FETCH_K=30
TOP_K=6
# coverage = 词覆盖重排（无依赖，默认）；cross-encoder = bge-reranker（需 pip install .[rerank]）；none = 关闭
RERANK=coverage
RERANK_MODEL=BAAI/bge-reranker-base
RRF_K=60
MIN_EVIDENCE_SCORE=0.30

# ---- 生成 ----
# auto / zh / en：auto 表示跟随提问语言
DEFAULT_LANGUAGE=auto
QUIZ_MAX_QUESTIONS=10

# ---- 外部补充（可选） ----
# off = 默认：讲义证据不足直接拒答；wikipedia = 允许联网补充，答案会标注哪些内容不属于讲义
WEB_FALLBACK=off
WEB_LANG=auto
WEB_MAX_RESULTS=3
WEB_TIMEOUT=8
# 网络结果与问题的覆盖度低于该值视为不相关，直接放弃补充（避免答非所问）
WEB_MIN_COVERAGE=0.30

# ---- 评估 ----
# 留空表示不做 LLM-as-judge，只用确定性指标
EVAL_JUDGE_MODEL=
